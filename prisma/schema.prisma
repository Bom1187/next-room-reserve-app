generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Room {
  id        Int       @id @default(autoincrement())
  roomCode  String    @unique @db.VarChar(191)
  roomName  String    @db.VarChar(191)
  capacity  Int
  location  String?   @db.VarChar(191)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  bookings  Booking[]
}

model Booking {
  id            Int      @id @default(autoincrement())
  bookerName    String   @db.VarChar(191)
  purpose       String?  @db.Text
  startTime     DateTime @db.DateTime(3)
  endTime       DateTime @db.DateTime(3)
  attendeeCount Int
  roomId        Int
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([roomId])
}
